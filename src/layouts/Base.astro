---
import '../styles/global.css';
import QuoteDrift from '../components/QuoteDrift.astro';
import { allSections } from '../lib/taxonomy';

const sections = allSections();
const topics = sections.filter(s => s.kind === 'topic');
const forms  = sections.filter(s => s.kind === 'form');

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** True only on pages that open with the dark full-bleed hero. The nav
      inverts over it; everywhere else it must be ink on paper, or it is
      invisible until the reader scrolls. */
  overHero?: boolean;
}

const {
  title,
  description = 'The personal site of Cameron Hickey — founder of Hickey Avenue. Notes on value over price: running, whiskey, fatherhood, and the math of a good bet.',
  ogImage,
  overHero = false,
} = Astro.props;

/* A post's lead image doubles as its social preview; everything else
   falls back to the site card. og:image must be raster — every platform
   rejects SVG, which is why the old /og-default.svg never rendered. */
const ogPath = ogImage ?? '/og-default.png';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogPath, Astro.site);

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title === 'Cameron Hickey' ? title : `${title} — Cameron Hickey`}</title>
    <meta name="description" content={description} />

    <!-- OG / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Cameron Hickey"
      href="/rss.xml"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts — preconnect before stylesheet to avoid render block -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;500;600;700&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9MZJ6LMRC1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-9MZJ6LMRC1');
    </script>
  </head>
  <body>
    <nav class:list={['site-nav', overHero && 'site-nav--over-hero']} aria-label="Main navigation" id="site-nav">
      <div class="container--wide site-nav__inner">
        <a href="/" class="site-nav__logo">Cameron Hickey</a>
        <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-overlay" id="nav-burger">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <!-- The only nav. Three groups: topics, then the rooms, then the forms. -->
    <div class="nav-overlay" id="nav-overlay" aria-hidden="true">
      <nav class="nav-overlay__inner" aria-label="Site sections">
        <ul class="nav-group nav-group--topics">
          {topics.map(t => (
            <li><a href={`/${t.slug}`} class={isActive(`/${t.slug}`) ? 'nav-active' : ''}>{t.name}</a></li>
          ))}
        </ul>

        <hr class="nav-group__rule" />

        <ul class="nav-group nav-group--rooms">
          <li><a href="/now"       class={isActive('/now')       ? 'nav-active' : ''}>Now</a></li>
          <li><a href="/living"    class={isActive('/living')    ? 'nav-active' : ''}>Living</a></li>
          <li><a href="/listening" class={isActive('/listening') ? 'nav-active' : ''}>Listening</a></li>
          <li><a href="/archive"   class={isActive('/archive')   ? 'nav-active' : ''}>Archive</a></li>
          <li><a href="/cameron" class={isActive('/cameron') ? 'nav-active' : ''}>Cameron</a></li>
        </ul>

        <hr class="nav-group__rule" />

        <ul class="nav-group nav-group--forms">
          {forms.map(f => (
            <li><a href={`/${f.slug}`} class={isActive(`/${f.slug}`) ? 'nav-active' : ''}>{f.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <!-- Ambient quote layer — see src/data/QUOTES.md -->
    <QuoteDrift />

    <footer class="site-footer">
      <div class="container--wide site-footer__inner">
        <div>
          <a href="/" class="site-footer__logo">Cameron Hickey</a>
          <p class="site-footer__copy">&copy; 2026 Cameron Hickey &middot; Florida, USA</p>
        </div>
        <ul class="site-footer__socials">
          <li><a href="https://www.youtube.com/@cmrnhcky" target="_blank" rel="noopener">YouTube</a></li>
          <li><a href="https://twitter.com/cmrnhcky" target="_blank" rel="noopener">X</a></li>
          <li><a href="https://instagram.com/cmrnhcky" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://www.linkedin.com/in/cmrnhcky/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <div class="container--wide">
        <p class="site-footer__ha">
          Digital infrastructure for growing business &mdash; <a href="https://hickeyave.com" target="_blank" rel="noopener">hickeyave.com</a>
        </p>
      </div>
    </footer>

    <!-- Nav scroll + burger -->
    <script is:inline>
      (function () {
        var nav    = document.getElementById('site-nav');
        var burger = document.getElementById('nav-burger');
        var overlay = document.getElementById('nav-overlay');

        // Scroll: add .scrolled when past the hero
        function onScroll() {
          if (window.scrollY > 60) {
            nav.classList.add('scrolled');
          } else {
            nav.classList.remove('scrolled');
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Burger toggle
        burger.addEventListener('click', function () {
          var open = document.body.classList.toggle('nav-open');
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
        });

        // Escape closes the overlay.
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && document.body.classList.contains('nav-open')) {
            document.body.classList.remove('nav-open');
            burger.setAttribute('aria-expanded', 'false');
            burger.setAttribute('aria-label', 'Open menu');
            overlay.setAttribute('aria-hidden', 'true');
          }
        });

        // Close overlay on link click
        overlay.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            document.body.classList.remove('nav-open');
            burger.setAttribute('aria-expanded', 'false');
            overlay.setAttribute('aria-hidden', 'true');
          });
        });
      })();
    </script>

    <!-- Scroll-triggered fade-up for sections -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); } }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
