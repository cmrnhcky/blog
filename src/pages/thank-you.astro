---
import Base from '../layouts/Base.astro';
---

<Base title="Thank you" description="You're on the list.">
  <section class="section--lg message-page">
    <div class="container">
      <p class="message-page__quote">
        &ldquo;The only thing to do with good advice is to pass it on.&rdquo;
      </p>
      <p class="message-page__attr">&mdash; Oscar Wilde</p>
      <p class="message-page__body">
        You&rsquo;re on the list. Occasional notes, no schedule, no spam &mdash; exactly as advertised.
      </p>
      <a href="/" class="message-page__link">Cameron Hickey</a>
    </div>
  </section>
</Base>
