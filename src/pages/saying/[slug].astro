---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import QuoteRail from '../../components/QuoteRail.astro';

export async function getStaticPaths() {
  const posts = await getCollection('saying', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatted = post.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={post.data.title} description={post.data.excerpt}>
  <article class="section--lg">
    <div class="container">

      <!-- Header — kicker, headline, standfirst, dateline -->
      <header class="article-head">
        <p class="kicker">
          <a href="/saying">Saying</a><span class="kicker__sep">/</span>{post.data.pillar}
        </p>

        <h1 class="article-title">{post.data.title}</h1>

        {post.data.excerpt && <p class="standfirst">{post.data.excerpt}</p>}

        <p class="dateline">
          By <strong>Cameron Hickey</strong> &middot; {dateFormatted}
        </p>
      </header>

      {post.data.ritual && (
        <p class="ritual-stamp">{post.data.ritual}</p>
      )}

      <div class="prose prose--feature">
        <Content />
      </div>

      <QuoteRail count={2} seed={post.id} />

      <hr class="rule" />

      <!-- Footer nav -->
      <div class="folio">
        <a href="/saying" class="folio__link">&larr; All saying</a>
        <span>Filed under <strong>{post.data.pillar}</strong></span>
      </div>

      <!-- Email capture at bottom of every post -->
      <div class="email-capture email-capture--inset">
        <span class="email-capture__heading">Occasional notes.</span>
        <span class="email-capture__sub">No schedule. No spam. Just the things worth sharing.</span>
        <form
          class="email-capture__form"
          name="notes-signup"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="notes-signup" />
          <label class="sr-only" for="post-email-input">Email address</label>
          <input
            id="post-email-input"
            class="email-capture__input"
            type="email"
            name="email"
            placeholder="your@email.com"
            required
          />
          <button class="email-capture__btn" type="submit">I&rsquo;m in</button>
          <!-- Honeypot: visible to bots, hidden via CSS -->
          <label class="sr-only" for="post-bot-field">Leave this empty</label>
          <input id="post-bot-field" type="text" name="bot-field" class="sr-only" tabindex="-1" autocomplete="off" />
        </form>
      </div>

    </div>
  </article>
</Base>
