---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found">
  <section class="section--lg" style="text-align:center; min-height: 60vh; display:flex; align-items:center;">
    <div class="container">
      <p style="font-family: var(--font-body); font-style: italic; font-size: clamp(1.2rem, 3vw, 2rem); color: var(--ink); line-height: 1.5; margin-bottom: 1rem;">
        &ldquo;To expect the unexpected shows a thoroughly modern intellect.&rdquo;
      </p>
      <p style="font-family: var(--font-label); font-size: var(--step--2); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-ink); margin-bottom: 2.5rem;">
        &mdash; Oscar Wilde
      </p>
      <p style="font-family: var(--font-label); color: var(--ink-muted); font-size: 0.9rem; margin-bottom: 2rem;">
        That page doesn&rsquo;t exist. Which is unexpected. Which is, apparently, fine.
      </p>
      <a
        href="/"
        style="font-family: var(--font-display); font-size: 0.9rem; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold-ink); padding-bottom: 2px;"
      >
        Cameron Hickey
      </a>
    </div>
  </section>
</Base>
