---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { allSections, topicName, formName } from '../lib/taxonomy';
import { currentIssue } from '../lib/issues';
import { formatDate } from '../lib/dates';
import QuoteInterstitial from '../components/QuoteInterstitial.astro';
import QuoteRail from '../components/QuoteRail.astro';
import EmailCapture from '../components/EmailCapture.astro';

const allPosts = await getCollection('saying', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const topics = allSections().filter(s => s.kind === 'topic');
const issue = await currentIssue();
---

<Base title="Cameron Hickey" overHero={true}>

  <!-- ═══ THE COVER ════════════════════════════════════════════
       Typographic, no photograph. The five-photo Ken Burns crossfade
       it replaces was the weakest element on the site — a slideshow
       is a 2014 move, it cost LCP, and the library was camera roll.
       Type carries a cover perfectly well, and costs nothing. -->
  <section class="cover" id="top">
    <div class="cover__grain" aria-hidden="true"></div>

    <div class="cover__inner">
      <p class="cover__issue">
        {issue ? <>No. {issue.no} &middot; {issue.label}</> : <>The first issue</>}
      </p>

      <div class="cover__manifesto">
        <p class="label cover__attribution">Oscar Wilde &middot; 1892</p>
        <blockquote class="quote-lg cover__quote">
          &ldquo;A cynic is a man who knows the price of everything and the value of nothing.&rdquo;
        </blockquote>
        <hr class="cover__rule" aria-hidden="true" />
        <p class="display-md cover__counter">Price is nothing. Value is everything.</p>
      </div>

      <div class="cover__identity">
        <h1 class="cover__name">Cameron Hickey</h1>
        <p class="label cover__bio">Father, founder and drinker amongst other nouns.</p>
        <nav class="cover__socials" aria-label="Social links">
          <a href="https://www.linkedin.com/in/cmrnhcky/" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.youtube.com/@cmrnhcky" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://instagram.com/cmrnhcky" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://twitter.com/cmrnhcky" target="_blank" rel="noopener" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </nav>
      </div>
    </div>

    <a class="cover__scroll" href="#latest" aria-label="Scroll down">↓</a>
  </section>

  <!-- ═══ LATEST ═══════════════════════════════════════════════ -->
  {latestPosts.length > 0 && (
    <section class="section" id="latest">
      <div class="container--wide">
        <span class="section-label">Latest</span>
        <div class="post-grid">
          {latestPosts.map(post => (
            <a href={`/${post.data.topic}/${post.id}`} class="post-card fade-up">
              <span class="post-card__pillar">
                {post.data.form && <>{formName(post.data.form)} &middot; </>}
                {topicName(post.data.topic)}
              </span>
              <h2 class="post-card__title">{post.data.title}</h2>
              <p class="post-card__excerpt">{post.data.excerpt}</p>
              <span class="post-card__date">
                {formatDate(post.data.date)}
              </span>
            </a>
          ))}
        </div>
        <p class="more-wrap"><a href="/archive" class="more-link">The archive &rarr;</a></p>
      </div>
    </section>
  )}

  <div class="dinkus" role="separator" aria-hidden="true"><span></span></div>

  <!-- ═══ TOPICS ═══════════════════════════════════════════════ -->
  <section class="section" id="topics">
    <div class="container--wide">
      <span class="section-label">Six ways in.</span>
      <div class="pillars">
        {topics.map((t, i) => (
          <a href={`/${t.slug}`} class="pillar-card fade-up" style={`--n:${i}`}>
            <span class="pillar-card__name">{t.name}</span>
            <p class="pillar-card__desc">{t.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <QuoteInterstitial />

  <section class="section">
    <div class="container">
      <QuoteRail count={3} />
    </div>
  </section>

  <div class="dinkus" role="separator" aria-hidden="true"><span></span></div>

  <!-- ═══ DOORS ════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container--wide">
      <div class="doors">
        <a href="/living" class="door">
          <span class="door__name">Living</span>
          <p class="door__desc">The feed. Running, drinking, parenting. Everything in order.</p>
        </a>
        <a href="/archive" class="door">
          <span class="door__name">Archive</span>
          <p class="door__desc">Everything published, by issue. The whole body of work.</p>
        </a>
        <a href="/cameron" class="door">
          <span class="door__name">Cameron</span>
          <p class="door__desc">First generation father. Enterprise background. Why he builds.</p>
        </a>
      </div>
    </div>
  </section>

  <EmailCapture />

</Base>
