---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import QuoteInterstitial from '../components/QuoteInterstitial.astro';
import QuoteRail from '../components/QuoteRail.astro';

const allPosts = await getCollection('saying', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const pillars = [
  { name: 'Pours',      desc: 'Drinks with discernment. Beer, whiskey, gin. Value over prestige.',         href: '/saying?pillar=Pours' },
  { name: 'Miles',      desc: 'Running, trails, the outdoors. Discipline and where it leads.',              href: '/saying?pillar=Miles' },
  { name: 'Bets',       desc: 'Gambling with a bankroll brain. Value plays, honest wins and losses.',       href: '/saying?pillar=Bets' },
  { name: 'Kids',       desc: 'Fatherhood, Oscar, the morning. First generation figuring it out.',          href: '/saying?pillar=Kids' },
  { name: 'Essentials', desc: 'Must-have value-adds. Gear, tools, money. The frugal-but-not-cheap life.',  href: '/saying?pillar=Essentials' },
];
---

<Base title="Cameron Hickey" overHero={true}>

  <!-- ═══ HERO — rotating photo crossfade ═════════════════════ -->
  <!--
    HERO PHOTOS — TODO: replace with real Cameron photos
    Ideal shots:
    1. Cady Way trail or local trail at sunrise — Florida light low through trees
    2. The sliding back door from inside — morning light coming in
    3. Florida beach horizon at golden hour
    4. A cityscape from somewhere Cameron has actually stood
    5. A stadium exterior, pub sign, or scenic overlook from a run
    All landscape, minimum 1920×1080. Place in /public/hero/.
  -->
  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-slide" style="--i:0"><img src="/hero/IMG_1369.jpeg" alt="" /></div>
      <div class="hero-slide" style="--i:1"><img src="/hero/IMG_6720.jpeg" alt="" /></div>
      <div class="hero-slide" style="--i:2"><img src="/hero/IMG_2109.JPG" alt="" /></div>
      <div class="hero-slide" style="--i:3"><img src="/hero/IMG_2324.JPG" alt="" /></div>
      <div class="hero-slide" style="--i:4"><img src="/hero/IMG_2619.JPG" alt="" /></div>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-grain" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-manifesto">
        <p class="label hero-attribution">Oscar Wilde &middot; 1892</p>
        <blockquote class="quote-lg hero-quote">
          &ldquo;A cynic is a man who knows the price of everything and the value of nothing.&rdquo;
        </blockquote>
        <hr class="hero-rule" aria-hidden="true" />
        <p class="display-md hero-counter">Price is nothing. Value is everything.</p>
      </div>

      <div class="hero-identity">
        <h1 class="display-xl hero-name">Cameron Hickey</h1>
        <p class="label hero-bio">Father, founder and drinker amongst other nouns.</p>
        <nav class="hero-socials" aria-label="Social links">
          <a href="https://www.linkedin.com/in/cmrnhcky/" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.youtube.com/@cmrnhcky" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://instagram.com/cmrnhcky" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://twitter.com/cmrnhcky" target="_blank" rel="noopener" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </nav>
      </div>
    </div>

    <a class="hero-scroll" href="#pillars" aria-label="Scroll down">↓</a>
  </section>

  <!-- ═══ LATEST SAYING — warm ════════════════════════════════ -->
  {latestPosts.length > 0 && (
    <section class="section" id="saying">
      <div class="container--wide">
        <span class="section-label">Latest Saying</span>
        <div class="post-grid">
          {latestPosts.map(post => (
            <a href={`/saying/${post.id}`} class="post-card fade-up">
              <span class="post-card__pillar">{post.data.pillar}</span>
              <h2 class="post-card__title">{post.data.title}</h2>
              <p class="post-card__excerpt">{post.data.excerpt}</p>
              <span class="post-card__date">
                {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
        <p class="more-wrap"><a href="/saying" class="more-link">All saying &rarr;</a></p>
      </div>
    </section>
  )}

  <div class="dinkus" role="separator" aria-hidden="true"><span></span></div>

  <!-- ═══ PILLARS — warm ═══════════════════════════════════════ -->
  <section class="section" id="pillars">
    <div class="container--wide">
      <span class="section-label">Five Ways In.</span>
      <div class="pillars">
        {pillars.map((p, i) => (
          <a
            href={p.href}
            class="pillar-card fade-up"
            style={`--n:${i}`}
          >
            <span class="pillar-card__name">{p.name}</span>
            <p class="pillar-card__desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ QUOTE LAYER — driven by src/data/quotes.json ═════════ -->
  <QuoteInterstitial />

  <section class="section">
    <div class="container">
      <QuoteRail count={3} />
    </div>
  </section>

  <div class="dinkus" role="separator" aria-hidden="true"><span></span></div>

  <!-- ═══ SECTION DOORS ══════════════════════════════════════ -->
  <section class="section">
    <div class="container--wide">
      <div class="doors">
        <a href="/living" class="door">
          <span class="door__name">Living</span>
          <p class="door__desc">The feed. Running, drinking, parenting. Everything in order.</p>
        </a>
        <a href="/guessing" class="door">
          <span class="door__name">Guessing</span>
          <p class="door__desc">Open record. Every bet, every prediction. Wins and losses both.</p>
        </a>
        <a href="/cameron" class="door">
          <span class="door__name">Cameron</span>
          <p class="door__desc">First generation father. Enterprise background. Why he builds.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ EMAIL CAPTURE — dark bookend ═════════════════════════ -->
  <section class="email-capture" id="newsletter">
    <div class="container">
      <span class="email-capture__heading">Occasional notes.</span>
      <span class="email-capture__sub">No schedule. No spam. Just the things worth sharing.</span>
      <form
        name="notes-signup"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="email-capture__form"
      >
        <input type="hidden" name="form-name" value="notes-signup" />
        <label class="sr-only" for="bot-field-main">Leave this empty</label>
        <input id="bot-field-main" type="text" name="bot-field" class="sr-only" tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="email-main">Email address</label>
        <input
          id="email-main"
          class="email-capture__input"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
        />
        <button class="email-capture__btn" type="submit">I&rsquo;m in</button>
      </form>
    </div>
  </section>

</Base>

